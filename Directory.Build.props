<Project>

  <!-- Settings shared by every project in the solution. The assembly metadata
       below ends up in the Win32 resources of the .exe / .dll, which makes the
       signed binaries easier to identify in Explorer and in signtool output. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Version>1.0.0</Version>
    <Company>Keyfactor</Company>
    <Product>Signum Signing Sample</Product>
    <Copyright>Copyright (c) Keyfactor</Copyright>

    <!-- Deterministic builds: two builds of the same commit produce identical
         binaries, so the signature is the only difference between artifacts. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
